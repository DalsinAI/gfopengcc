+static char *PutNum(char *p, ULONG n)
+{
+	char b[12];
+	int i = 0;
+
+	do b[i++] = '0' + n % 10; while (n /= 10);
+	while (i)
+		*p++ = b[--i];
+	return p;
+}
+
+static void ExitLog(pthread_t thread, const char *name)
+{
+	static const char what[] = ": did not end within 2 s of exit, so it was removed\n";
+	char line[160], *p = line;
+	const char *prog = FindTask(NULL)->tc_Node.ln_Name;
+	struct CommandLineInterface *cli = BADDR(((struct Process *)FindTask(NULL))->pr_CLI);
+	BPTR fh;
+	int i;
+
+	if (cli && cli->cli_CommandName) {
+		UBYTE *b = BADDR(cli->cli_CommandName);
+		for (i = 0; i < b[0] && i < 60; i++)
+			*p++ = b[1 + i];
+	} else
+		for (i = 0; prog && prog[i] && i < 60; i++)
+			*p++ = prog[i];
+	memcpy(p, ": pthread ", 10); p += 10;
+	p = PutNum(p, thread);
+	*p++ = ' '; *p++ = '(';
+	for (i = 0; name && name[i] && name[i] != ' ' && i < 30; i++)	// pthread_create pads it
+		*p++ = name[i];
+	*p++ = ')';
+	memcpy(p, what, sizeof what - 1); p += sizeof what - 1;
+	if ((fh = Output()))
+		Write(fh, line, p - line);
+	if ((fh = Open((STRPTR)"T:pthreads-exit.log", MODE_READWRITE))) {
+		Seek(fh, 0, OFFSET_END);
+		Write(fh, line, p - line);
+		Close(fh);
+	}
+}
+
+static int ExitRemove(pthread_t thread)
+{
+	ThreadInfo *inf;
+	struct Task *t;
+	char name[NAMELEN];
+
+	ObtainSemaphore(&thread_sem);
+	inf = GetThreadInfo(thread);
+	if (inf == NULL || !inf->task || inf->task == (struct Task *)-1 || (inf->started && inf->finished)) {
+		ReleaseSemaphore(&thread_sem);
+		return 0;		// it ended after all: joined as usual
+	}
+	t = inf->task;
+	Forbid();
+	strncpy(name, t->tc_Node.ln_Name ? t->tc_Node.ln_Name : "", NAMELEN - 1);
+	name[NAMELEN - 1] = 0;
+	NEWLIST(&t->tc_MemEntry);
+	RemTask(t);
+	PurgeWaiter(&thread_sem, t);
+	PurgeWaiter(&tls_sem, t);
+	inf->task = NULL;	// the slot is no longer a thread's
+	inf->finished = 1;
+	Permit();
+	ReleaseSemaphore(&thread_sem);
+	ExitLog(thread, name);
+	return 1;
+}
+
+static int ExitTick(void)
+{
+	if (SetSignal(0, 0) & SIGBREAKF_CTRL_C)
+		exit_ticks = 0;
+	if (exit_ticks <= 0)
+		return 0;
+	Delay(2);
+	exit_ticks -= 2;
+	return 1;
+}
