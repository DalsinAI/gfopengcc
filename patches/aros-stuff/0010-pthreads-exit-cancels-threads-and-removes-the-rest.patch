+   pthreads' own semaphores are taken out of their queues, so they are never
+   handed to it. Each removal is one line on the program's output and in
+   T:pthreads-exit.log. A Ctrl-C to the program while it waits ends the wait. */
+#define EXIT_TICKS 100
+static LONG exit_ticks = EXIT_TICKS;
+
+static void PurgeWaiter(struct SignalSemaphore *sem, struct Task *t)
+{
+	struct SemaphoreRequest *sr, *next;
+
+	for (sr = (struct SemaphoreRequest *)sem->ss_WaitQueue.mlh_Head;
+	     (next = (struct SemaphoreRequest *)sr->sr_Link.mln_Succ); sr = next)
+		if (((ULONG)sr->sr_Waiter & ~1UL) == (ULONG)t) {
+			Remove((struct Node *)sr);
+			sem->ss_QueueCount--;
+		}
+}
