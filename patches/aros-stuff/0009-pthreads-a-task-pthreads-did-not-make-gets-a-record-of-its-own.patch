@@ -166,6 +212,40 @@ static ThreadInfo* GetThreadInfo(pthread_t thread) {
 	return 0;
 }
 
+#ifdef FOREIGN_RECORDS
+/* ml is one of this program's tokens: the slot it is for, or -1. */
+static long TokenSlot(struct MemList *ml) {
+	ULONG *b;
+
+	if (ml->ml_Node.ln_Type != NT_MEMORY || ml->ml_Node.ln_Pri != TOKEN_PRI || ml->ml_NumEntries != 1
+	    || ml->ml_ME[0].me_Length != 3 * sizeof(ULONG))
+		return -1;
+	b = (ULONG *)ml->ml_ME[0].me_Addr;
+	if (!b || ((ULONG)b & 1) || b[0] != TOKEN_MAGIC || b[2] != (ULONG)_threads)
+		return -1;
+	return (long)b[1];
+}
+
+/* The first token of this program's on task's tc_MemEntry (slot >= 0: the one for
+   that slot), or NULL. The caller's own list, or another task's under Disable(). */
+static struct MemList *FindToken(struct Task *task, long slot) {
+	struct Node *n = task->tc_MemEntry.lh_Head;
+	int k;
+
+	// a hand-made task may never have had its list initialised
+	for (k = 0; n && !((ULONG)n & 1) && n->ln_Succ && k < MAX_MEMENTRY_WALK; n = n->ln_Succ, k++) {
+		long s = TokenSlot((struct MemList *)n);
+		if (s != -1 && (slot < 0 || s == slot))
+			return (struct MemList *)n;
+	}
+	return NULL;
+}
+
+static int TokenHeld(struct Task *task, struct MemList *token, pthread_t slot) {
+	return token && FindToken(task, (long)slot) == token;
+}
+#endif
