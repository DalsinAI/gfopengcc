+#ifdef FOREIGN_RECORDS
+			// a foreign record is the caller's only if its token is on the caller's own
+			// list: an ended task's record is never taken by a new task at its address
+			if (task && _threads[i]->foreign && !TokenHeld(task, _threads[i]->token, i))
+				continue;
+#endif
