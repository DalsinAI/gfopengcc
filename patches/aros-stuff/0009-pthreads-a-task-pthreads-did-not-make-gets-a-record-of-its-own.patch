@@ -202,6 +289,252 @@ static int __m68k_sync_val_compare_and_swap(int *v, int o, int n)
 #undef __sync_lock_test_and_set
 #endif
 
+/* A free slot (its task NULL), growing the table if need be, or
+   PTHREAD_THREADS_MAX when the table is full or memory is short. thread_sem held. */
+static pthread_t FreeSlot(void) {
+	pthread_t threadnew = GetThreadId(NULL);
+
+	if (threadnew == PTHREAD_THREADS_MAX)
+		return PTHREAD_THREADS_MAX;
+
+	if (threadnew == numThreads) {
+		// resize the thread's storage.
+		unsigned n = numThreads + numThreads + 2;
+
+		D(bug("** %s(resize to %ld)\n", __FUNCTION__, n));
+
+		if (n > PTHREAD_THREADS_MAX)
+			n = PTHREAD_THREADS_MAX;
+
+		if (n != numThreads) {
+			unsigned i;
+			for (i = numThreads; i < n; i++) {
+				ThreadInfo *t = (ThreadInfo*) calloc(1, sizeof(ThreadInfo));
+				if (!t) {
+					numThreads = i;
+					return PTHREAD_THREADS_MAX;
+				}
+				_threads[i] = t;
+			}
+			numThreads = n;
+		}
+	}
+	return threadnew;
+}
+
+#ifdef FOREIGN_RECORDS
+/* Run a reaped record's key destructors, as StarterFunc does for a thread that
+   ends, then free its slot. thread_sem is not held (the destructors may call
+   pthreads); the records are FOREIGN_REAPING, so no one else touches them. */
+static void ForeignReap(ThreadInfo *list) {
+	ThreadInfo *inf;
+	int i, j, foundkey;
+
+	for (inf = list; inf; inf = (ThreadInfo *)inf->reapnext) {
+		CleanupHandler *handler;
+
+		ObtainSemaphoreShared(&tls_sem);
+		foundkey = TRUE;
+		for (j = 0; foundkey && j < PTHREAD_DESTRUCTOR_ITERATIONS; j++) {
+			foundkey = FALSE;
+			for (i = 0; i < numTlskeys; i++) {
+				if (_tlskeys[i].used && _tlskeys[i].destructor && inf->tlsvalues[i]) {
+					void *oldvalue = inf->tlsvalues[i];
+					inf->tlsvalues[i] = NULL;
+					_tlskeys[i].destructor(oldvalue);
+					foundkey = TRUE;
+				}
+			}
+		}
+		ReleaseSemaphore(&tls_sem);
+		// cleanup handlers its task pushed and never popped: freed, not run
+		while ((handler = (CleanupHandler*) RemHead((struct List*) &inf->cleanup)))
+			free(handler);
+	}
+
+	ObtainSemaphore(&thread_sem);
+	while ((inf = list)) {
+		list = (ThreadInfo *)inf->reapnext;
+		inf->reapnext = NULL;
+		inf->token = NULL;
+		inf->foreign = 0;
+		inf->task = NULL;	// the slot is free
+		numForeign--;
+	}
+	ReleaseSemaphore(&thread_sem);
+}
+
+/* Mark every live foreign record whose token is on a running task's list.
+   Disable() held: the task lists, and each task's tc_MemEntry, hold still. */
+static void ForeignMark(struct Task *task) {
+	struct Node *n = task->tc_MemEntry.lh_Head;
+	int k;
+
+	for (k = 0; n && !((ULONG)n & 1) && n->ln_Succ && k < MAX_MEMENTRY_WALK; n = n->ln_Succ, k++) {
+		long s = TokenSlot((struct MemList *)n);
+		if (s >= 0 && (ULONG)s < numThreads) {
+			ThreadInfo *inf = _threads[s];
+			if (inf->foreign == FOREIGN_LIVE && inf->token == (struct MemList *)n && inf->task == task)
+				inf->alive = 1;
+		}
+	}
+}
+
+/* thread_sem held. The foreign records whose task has ended, taken out of use
+   (FOREIGN_REAPING) and chained for ForeignReap. */
+static ThreadInfo *ForeignCollect(void) {
+	ThreadInfo *list = NULL;
+	struct Node *n;
+	pthread_t i;
+
+	if (!numForeign)
+		return NULL;
+	for (i = 0; i < numThreads; i++)
+		_threads[i]->alive = 0;
+	Disable();
+	ForeignMark(SysBase->ThisTask);
+	for (n = SysBase->TaskReady.lh_Head; n->ln_Succ; n = n->ln_Succ)
+		ForeignMark((struct Task *)n);
+	for (n = SysBase->TaskWait.lh_Head; n->ln_Succ; n = n->ln_Succ)
+		ForeignMark((struct Task *)n);
+	Enable();
+	for (i = 0; i < numThreads; i++) {
+		ThreadInfo *inf = _threads[i];
+		if (inf->foreign == FOREIGN_LIVE && !inf->alive) {
+			D(bug("%s: foreign thread %ld (task %8lx) has ended\n", __FUNCTION__, i, inf->task));
+			inf->foreign = FOREIGN_REAPING;
+			inf->task = (struct Task *)-1;	// in no one's use, and not free yet
+			inf->reapnext = list;
+			list = inf;
+		}
+	}
+	return list;
+}
+
+/* Reclaim the records of foreign tasks that have ended. thread_sem not held. */
+static void ForeignSweep(void) {
+	ThreadInfo *list;
+
+	if (!numForeign)
+		return;
+	ObtainSemaphore(&thread_sem);
+	list = ForeignCollect();
+	ReleaseSemaphore(&thread_sem);
+	if (list)
+		ForeignReap(list);
+}
+
+static struct MemList *NewToken(void) {
+	struct MemList *ml = (struct MemList *)AllocMem(sizeof(struct MemList), MEMF_PUBLIC | MEMF_CLEAR);
+	ULONG *b;
+
+	if (!ml)
+		return NULL;
+	b = (ULONG *)AllocMem(3 * sizeof(ULONG), MEMF_PUBLIC);
+	if (!b) {
+		FreeMem(ml, sizeof(struct MemList));
+		return NULL;
+	}
+	b[0] = TOKEN_MAGIC;
+	b[1] = FALLBACK_SLOT;
+	b[2] = (ULONG)_threads;
+	ml->ml_Node.ln_Type = NT_MEMORY;
+	ml->ml_Node.ln_Pri = TOKEN_PRI;
+	ml->ml_NumEntries = 1;
+	ml->ml_ME[0].me_Addr = (APTR)b;
+	ml->ml_ME[0].me_Length = 3 * sizeof(ULONG);
+	return ml;
+}
+
+/* The calling task, which pthreads did not make, gets a record of its own; its
+   id, or 0 (the main thread) when the table is full or memory is short. */
+static pthread_t ForeignRegister(struct Task *task) {
+	struct MemList *token;
+	ThreadInfo *inf;
+	pthread_t slot;
+
+	// a task that was refused a record stays the main thread
+	if (FindToken(task, (long)FALLBACK_SLOT))
+		return 0;
+
+	token = NewToken();
+	if (!token)
+		return 0;	// no memory: the main thread, and asked again next time
+
+	// reclaim ended tasks' records first, so their slots are free for this one
+	ForeignSweep();
+	ObtainSemaphore(&thread_sem);
+	slot = FreeSlot();
+	if (slot == PTHREAD_THREADS_MAX) {
+		// table full: the main thread for this task's whole life (0008's answer)
+		D(bug("%s: no slot for task %8lx, it is the main thread\n", __FUNCTION__, task));
+		Forbid();
+		AddTail(&task->tc_MemEntry, &token->ml_Node);
+		Permit();
+		ReleaseSemaphore(&thread_sem);
+		return 0;
+	}
+	inf = GetThreadInfo(slot);
+	memset(inf, 0, sizeof(ThreadInfo));
+	pthread_attr_init(&inf->attr);
+	inf->attr.detachstate = PTHREAD_CREATE_DETACHED;	// nobody joins it
+	NEWLIST((struct List* )&inf->cleanup);
+	inf->cancelstate = PTHREAD_CANCEL_ENABLE;
+	inf->canceltype = PTHREAD_CANCEL_DEFERRED;
+	inf->started = 1;
+	inf->foreign = FOREIGN_LIVE;
+	((ULONG *)token->ml_ME[0].me_Addr)[1] = slot;
+	inf->token = token;
+	Forbid();
+	AddTail(&task->tc_MemEntry, &token->ml_Node);
+	Permit();
+	inf->task = task;	// last: the record is complete before GetThreadId can match it
+	numForeign++;
+	ReleaseSemaphore(&thread_sem);
+	D(bug("%s: task %8lx is foreign thread %ld\n", __FUNCTION__, task, slot));
+	return slot;
+}
+
+/* At exit: this program's tokens off the tasks still running (an ended task's
+   went with it), and every foreign record dropped. No destructors: the
+   program's code and data are about to go. */
+static void ForeignDrop(void) {
+	struct MinList gone;
+	struct Node *n, *t;
+	struct MemList *ml;
+	pthread_t i;
+	int k;
+
+	NEWLIST((struct List *)&gone);
+	ObtainSemaphore(&thread_sem);
+	Disable();
+	for (k = 0; k < 2; k++) {
+		for (t = (k ? SysBase->TaskWait : SysBase->TaskReady).lh_Head; t->ln_Succ; t = t->ln_Succ)
+			while ((ml = FindToken((struct Task *)t, -1))) {
+				Remove(&ml->ml_Node);
+				AddTail((struct List *)&gone, &ml->ml_Node);
+			}
+	}
+	while ((ml = FindToken(SysBase->ThisTask, -1))) {
+		Remove(&ml->ml_Node);
+		AddTail((struct List *)&gone, &ml->ml_Node);
+	}
+	Enable();
+	for (i = 0; i < numThreads; i++) {
+		ThreadInfo *inf = _threads[i];
+		if (inf->foreign) {
+			inf->foreign = 0;
+			inf->token = NULL;
+			inf->task = NULL;
+		}
+	}
+	numForeign = 0;
+	ReleaseSemaphore(&thread_sem);
+	while ((n = RemHead((struct List *)&gone)))
+		FreeEntry((struct MemList *)n);
+}
+#endif
