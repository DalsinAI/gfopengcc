From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SacredTrees <121399723+SacredTrees@users.noreply.github.com>
Date: Fri, 6 Nov 2026 16:00:00 +0000
Subject: [PATCH] amigaos: build dedicated m68040 multilibs

True 68040 applications currently select the 68020 target libraries.  That
is ISA-compatible but loses 68040 tuning and lets inline COMDAT sections in
the application differ from the library copies.  The hunk linker then warns
that duplicate sections have different contents; std::function's destructor
is one observed case.

Build soft- and hard-float 68040 libraries for the plain, base-relative and
base-relative-32 models.  Keep the 68020-40 and 68020-60 range targets on the
68020 library because those binaries still promise to run on an actual 020.
Select libm040 as the C-runtime linker subdirectory for true 68040 targets so
the new target libraries cannot be shadowed by libm020.  The AmigaOS multilib
set grows from eleven to seventeen entries.
---
 gcc/config/m68k/m68kamigaos.h |  3 ++-
 gcc/config/m68k/t-amigaos     | 17 ++++++++---------
 2 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/gcc/config/m68k/m68kamigaos.h b/gcc/config/m68k/m68kamigaos.h
index ae665185325..57bbd020541 100644
--- a/gcc/config/m68k/m68kamigaos.h
+++ b/gcc/config/m68k/m68kamigaos.h
@@ -554,6 +554,7 @@ extern const char *amigaos_crt_check (int argc, const char **argv);
 
 #define LINK_CPU_SPEC \
-  "%{m6802*|mc6802*|m6803*|m6804*|m6806*|m6808*|mcpu=6802*|mcpu=6803*|mcpu=6804*|mcpu=6806*|mcpu=6808*:-fl libm020} " \
+  "%{m6802*|mc6802*|m6803*|m6806*|m6808*|mcpu=6802*|mcpu=6803*|mcpu=6806*|mcpu=6808*:-fl libm020} " \
+  "%{m6804*|mc6804*|mcpu=6804*:-fl libm040} " \
   "%{mhard-float|m68881|mcpu=6806*|mcpu=6808*:-fl libm881}"
 
 #ifdef TARGET_AMIGAOS_VASM

diff --git a/gcc/config/m68k/t-amigaos b/gcc/config/m68k/t-amigaos
index 13c46f912..3d12eb80a 100644
--- a/gcc/config/m68k/t-amigaos
+++ b/gcc/config/m68k/t-amigaos
@@ -41,8 +41,8 @@ amigacollect2.o: amigacollect2.cc
 ### end-GG-local
 
 # Support for building multiple version of libgcc, libquadmath, libobjc and libstdc++-v3
-MULTILIB_OPTIONS    = fbaserel/fbaserel32 mcpu=68020/mcpu=68060 m68881
-MULTILIB_DIRNAMES   = libb libb32 libm020 libm060 libm881
+MULTILIB_OPTIONS    = fbaserel/fbaserel32 mcpu=68020/mcpu=68040/mcpu=68060 m68881
+MULTILIB_DIRNAMES   = libb libb32 libm020 libm040 libm060 libm881
 MULTILIB_EXTRA_OPTS = 
 MULTILIB_EXCEPTIONS = fbaserel/m68881 fbaserel/mcpu=68060/m68881 \
                       fbaserel32 fbaserel32/m68881 fbaserel32/mcpu=68060/m68881 \
@@ -50,12 +50,11 @@ MULTILIB_EXCEPTIONS = fbaserel/m68881 fbaserel/mcpu=68060/m68881 \
-# Every spelling of a 68020-class or better CPU selects the multilib built for
-# it. Without these matches only -m68020, -mcpu=68020, -m68060 and -mcpu=68060
-# leave the 68000 libraries: -m68030, -m68040, -m68020-40, -m68020-60 and every
-# -march= spelling linked the 68000 libgcc, libstdc++ and libnix into code
-# generated for an 020 or better.
+# Every spelling of a 68020-class or better CPU selects its compatible
+# multilib.  The 68020-40 and 68020-60 range targets deliberately keep the
+# 68020 library because they promise to run on an actual 020; a true 68040
+# selects the separately tuned 68040 library.
 # -resident and -resident32 compile as -fbaserel and -fbaserel32 (CC1_SPEC), so
 # they take the base-relative libraries too; -resident32 alone linked libm020's.
-MULTILIB_MATCHES    = mcpu?68020=mcpu?68030 mcpu?68020=mcpu?68040 \
+MULTILIB_MATCHES    = mcpu?68020=mcpu?68030 \
                       mcpu?68020=m68020-40 mcpu?68020=m68020-60 \
                       mcpu?68020=march?68020 mcpu?68020=march?68030 \
-                      mcpu?68020=march?68040 mcpu?68060=march?68060 \
+                      mcpu?68040=march?68040 mcpu?68060=march?68060 \
                       fbaserel=resident fbaserel32=resident32
-- 
